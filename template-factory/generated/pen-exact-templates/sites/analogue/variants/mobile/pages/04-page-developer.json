        "x": 42,
        "y": 483,
        "fill": "#111111",
        "content": "openFPGA starts at the beginning of Video Games: Spacewar! on PDP-1 In 1962, the first digital video game, Spacewar! debuted on an early computer released in 1959 called the PDP-1 at MIT.",
        "fontFamily": "Helvetica Neue",
        "fontSize": 13,
        "fontWeight": "500",
        "textGrowth": "fixed-width-height",
