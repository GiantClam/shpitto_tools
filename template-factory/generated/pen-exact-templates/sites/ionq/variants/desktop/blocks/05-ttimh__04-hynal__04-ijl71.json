        "textGrowth": "fixed-width",
        "width": 430,
        "content": "The atom: nature’s qubit",
        "lineHeight": 1.08,
        "fontFamily": "Inter",
        "fontSize": 36,
        "fontWeight": "700"
      },
      {
        "type": "text",
        "id": "ldfL7",
