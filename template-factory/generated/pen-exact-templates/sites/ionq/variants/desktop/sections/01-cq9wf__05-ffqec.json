    {
      "blockId": "mbq3Q",
      "blockName": "aboutP1",
      "blockType": "text",
      "blockRole": "text",
      "order": 1,
      "bounds": {
        "x": 126,
        "y": 188,
        "width": 948,
        "height": ""
      },
      "directChildCount": 0,
      "recursiveNodeCount": 1,
      "treeHash": "2e06d73ea592f58fcbea0b692be9786067977e9e4e4851d3c05e2f7067f8aa2e",
      "assetRef": null,
      "rawBlockNode": {
        "type": "text",
        "id": "mbq3Q",
        "x": 126,
        "y": 188,
        "name": "aboutP1",
        "fill": "#5B6470",
        "textGrowth": "fixed-width",
        "width": 948,
        "content": "Founded in 2015 by Dr. Chris Monroe and Dr. Jungsang Kim, IonQ emerged from more than 30 years of academic research and foundational breakthroughs licensed from the University of Maryland and Duke University. With early support from global venture capital firm New Enterprise Associates and the goal of bringing trapped ion quantum computing out of the lab and into real-world use, IonQ has since grown into a global leader in quantum computing, networking, and sensing.",
        "lineHeight": 1.5,
        "fontFamily": "Inter",
        "fontSize": 14,
        "fontWeight": "500"
      }
    },
    {
      "blockId": "NFrVC",
      "blockName": "aboutP2",
      "blockType": "text",
      "blockRole": "text",
      "order": 2,
      "bounds": {
        "x": 126,
        "y": 290,
        "width": 948,
        "height": ""
      },
      "directChildCount": 0,
      "recursiveNodeCount": 1,
      "treeHash": "c6b6313213122cbdf42bef42cfd671c7f8c5a5ec4a8edc409330739fe6caed7e",
      "assetRef": null,
      "rawBlockNode": {
        "type": "text",
        "id": "NFrVC",
        "x": 126,
        "y": 290,
        "name": "aboutP2",
        "fill": "#5B6470",
        "textGrowth": "fixed-width",
        "width": 948,
        "content": "IonQ has established partnerships with leading academic institutions, industry innovators, and federal agencies, and continues to advance one of the most aggressive technology roadmaps in the field. Our mission is to solve problems that are beyond the reach of classical systems.",
        "lineHeight": 1.5,
        "fontFamily": "Inter",
        "fontSize": 14,
        "fontWeight": "500"
      }
    },
