      "treeHash": "f31642d5594094f1be09e5735bacd35c57c2a2130f4eae0666343160f601432d",
      "assetRef": null,
      "rawBlockNode": {
        "type": "frame",
        "id": "afHvv",
        "x": 62,
        "y": 236,
        "name": "col1",
        "width": 344,
