{
  "name": "builder",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@babel/standalone": "^7.28.6",
    "@langchain/core": "^1.1.17",
    "@langchain/langgraph": "^1.1.2",
    "@measured/puck": "^0.20.2",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.0",
    "framer-motion": "^12.29.2",
    "https-proxy-agent": "^7.0.5",
    "lucide-react": "^0.476.0",
    "next": "^15.1.0",
    "node-fetch": "^3.3.2",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "build": "NEXT_DIST_DIR=.next-prod node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build",
    "start": "NEXT_DIST_DIR=.next-prod next start",
    "regression:creation": "node regression/run-creation-baseline.mjs",
    "regression:creation:website": "node regression/run-creation-baseline.mjs --prompts regression/prompts.website-refactor.json",
    "regression:creation:interiors": "node regression/run-creation-baseline.mjs --prompts regression/prompts.family-agnostic-interiors.json",
    "regression:creation:timeout-pagination": "node regression/run-creation-baseline.mjs --prompts regression/prompts.timeout-pagination.json --case-id timeout-catalog-pagination-preserved --persist true --request-timeout-ms 10000 --pending-wait-ms 180000 --enforce-progress-stages true --enforce-publish-ready false --enforce-no-gate-issues false",
    "regression:quick": "node regression/run-quick-regression.mjs",
    "regression:quick:timeout-pagination": "node regression/run-quick-regression.mjs --creation-only --with-timeout-pagination",
    "regression:quick:creation": "node regression/run-quick-regression.mjs --creation-only",
    "regression:quick:browser": "node regression/run-quick-regression.mjs --browser-only",
    "regression:page-type-skill": "node regression/run-page-type-skill-benchmark.mjs",
    "regression:adaptation": "node regression/run-template-adaptation-save-fixtures.mjs",
    "regression:browser:refactor": "node regression/run-browser-refactor-validation.mjs",
    "regression:sandbox:nav": "node regression/run-sandbox-nav-consistency.mjs",
    "regression:strategy": "node regression/run-strategy-comparison.mjs",
    "regression:strategy:pen": "node regression/run-strategy-comparison.mjs --prompts regression/prompts.pen-published.json",
    "template:factory": "node template-factory/run-template-factory.mjs"
  },
  "devDependencies": {
    "@types/react": "19.2.9",
    "autoprefixer": "^10.4.20",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "5.9.3"
  }
}
